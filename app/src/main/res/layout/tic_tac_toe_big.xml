<?xml version="1.0" encoding="utf-8"?>
<janluca.de.ultimatetictactoe.TicTacToeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/field_white">

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">


        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="@string/field_1"
            android:id="@+id/outerFieldZero">

            <include layout="@layout/tic_tac_toe_small" />

        </FrameLayout>

        <View
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="#000000"/>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="@string/field_2"
            android:id="@+id/outerFieldOne">

            <include layout="@layout/tic_tac_toe_small" />

        </FrameLayout>

        <View
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="#000000"/>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="@string/field_3"
            android:id="@+id/outerFieldTwo">

            <include layout="@layout/tic_tac_toe_small" />

        </FrameLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:background="#000000"/>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="@string/field_4"
            android:id="@+id/outerFieldThree">

            <include layout="@layout/tic_tac_toe_small" />

        </FrameLayout>

        <View
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="#000000"/>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="@string/field_5"
            android:id="@+id/outerFieldFour">

            <include layout="@layout/tic_tac_toe_small" />

