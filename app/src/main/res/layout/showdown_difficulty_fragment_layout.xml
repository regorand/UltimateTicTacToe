<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false">

    <TextView
        android:paddingTop="30dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/choose_showdown_diff_text"
        android:textSize="25sp"
        android:gravity="center"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal" >

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_weight="1">

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <Button
                android:text="@string/very_easy_bot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/very_easy_bot_button_X"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/showdown_button_not_selected" />

            <Button
                android:text="@string/easy_bot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/easy_bot_button_X"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/showdown_button_not_selected" />

            <Button
                android:text="@string/medium_bot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/medium_bot_button_X"
                android:layout_marginBottom="10dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:background="@color/showdown_button_not_selected" />

            <Button
                android:text="@string/hard_bot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/hard_bot_button_X"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/showdown_button_not_selected" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textSize="30sp"
            android:text="@string/versus_tag"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_weight="1">

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <Button
                android:text="@string/very_easy_bot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/very_easy_bot_button_O"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/showdown_button_not_selected"/>

            <Button
                android:text="@string/easy_bot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/easy_bot_button_O"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/showdown_button_not_selected"/>

            <Button
                android:text="@string/medium_bot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/medium_bot_button_O"
                android:layout_marginBottom="10dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:background="@color/showdown_button_not_selected" />

            <Button
                android:text="@string/hard_bot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/hard_bot_button_O"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/showdown_button_not_selected" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>

        </LinearLayout>

    </LinearLayout>

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bot_showdown_button_text"
        android:id="@+id/start_showdown_button"/>

</LinearLayout>